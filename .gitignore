# Local secrets and machine-specific config; never committed.
local/

# Runtime data: SQLite database, WAL files, hook spool.
/data/

# Daily backup snapshots.
backups/

# Design-review artifacts (screenshots include work-calendar content).
.impeccable/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Agent skills: .agents/skills/ and skills-lock.json are the committed source;
# .claude/skills/ holds the installer's machine-local junctions into it.
.claude/skills/

# The CodeMirror build's packages (scripts/vendor/codemirror; its output is committed).
node_modules/

# Git worktrees agents work in (their own checkouts, never part of this one).
.claude/worktrees/

# The desktop app's build (desktop/build.ps1).
/build/

# The keys chosen over the defaults (app/services/keys.py), in the home: the
# repo itself when the app runs from it.
/keys.toml

# The everyday files of a run from the repo (repos/, projects/, work/; app/config.py).
/everyday-files/

# Nutrition's files of a run from the repo (personal; [nutrition].dir in app/config.py).
/nutrition/

# What an improvement run that found nothing to fix leaves for improve/run.py.
/improve-outcome.md
